{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts"
  ],
  "exclude": [
    "README.md",
    "node_modules",
  ]
}
